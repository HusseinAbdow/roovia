rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures - users can only upload/update their own
    match /profile_images/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    
    // House images if needed in future - members of house can upload
    match /house_images/{houseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Can add more restrictive rules later
      allow delete: if request.auth != null;
    }
  }
}
