rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function houseExists(houseId) {
      return exists(/databases/$(database)/documents/houses/$(houseId));
    }

    function houseData(houseId) {
      return get(/databases/$(database)/documents/houses/$(houseId)).data;
    }

    function isHouseLeader(houseId) {
      return signedIn() &&
          houseExists(houseId) &&
          houseData(houseId).leaderId == request.auth.uid;
    }

    function isHouseMember(houseId) {
      return signedIn() &&
          houseExists(houseId) &&
          (
            (('members' in houseData(houseId)) && request.auth.uid in houseData(houseId).members) ||
            (('memberIds' in houseData(houseId)) && request.auth.uid in houseData(houseId).memberIds) ||
            (('users' in houseData(houseId)) && request.auth.uid in houseData(houseId).users) ||
            (('userIds' in houseData(houseId)) && request.auth.uid in houseData(houseId).userIds)
          );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(uid);
    }

    match /houses/{houseId} {
      allow read: if signedIn();

      allow create: if signedIn()
          && request.resource.data.leaderId == request.auth.uid
          && request.resource.data.members is list
          && request.resource.data.members.size() == 1
          && request.resource.data.members[0] == request.auth.uid
          && request.resource.data.houseId is string
          && request.resource.data.name is string
          && request.resource.data.inviteCode is string
          && request.resource.data.discoverable is bool;

      allow update, delete: if signedIn() && resource.data.leaderId == request.auth.uid;
    }

    match /join_requests/{requestId} {
      allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.houseId is string;

      allow read: if signedIn() &&
          (resource.data.userId == request.auth.uid || isHouseLeader(resource.data.houseId));

      allow update: if signedIn() && isHouseLeader(resource.data.houseId);

      allow delete: if signedIn() &&
          (resource.data.userId == request.auth.uid || isHouseLeader(resource.data.houseId));
    }

    match /house_chats/{houseId}/messages/{messageId} {
      allow read, write: if isHouseMember(houseId) || isHouseLeader(houseId);
    }

    // Per-user in-app notification authorization. The only legitimate
    // client producers are the ExpenseService flows (bill creation, payment
    // submission, approval, settlement, rejection, batch confirmation).
    // Every legitimate document carries fromUserId == sender, a
    // client-allowlisted type, a real expenseId whose houseId matches, and a
    // sender/recipient relationship backed by the expense creator and
    // participant documents (checked in their post-transition state, since
    // clients notify after the payment update commits). Server-only types
    // (chat_message, bill_due_*) are written via Admin SDK, which bypasses
    // these rules, and are never client-creatable. Helpers are
    // self-contained (direct exists/get) so this block does not depend on
    // helpers declared later in the file.
    function notifExpenseExists(expenseId) {
      return exists(/databases/$(database)/documents/house_expenses/$(expenseId));
    }

    function notifExpenseData(expenseId) {
      return get(/databases/$(database)/documents/house_expenses/$(expenseId)).data;
    }

    function notifParticipantExists(expenseId, uid) {
      return exists(/databases/$(database)/documents/house_expenses/$(expenseId)/participants/$(uid));
    }

    function notifParticipantData(expenseId, uid) {
      return get(/databases/$(database)/documents/house_expenses/$(expenseId)/participants/$(uid)).data;
    }

    function notifBaseValid(uid) {
      return signedIn()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.expenseId is string
          && request.resource.data.expenseId.size() > 0
          && notifExpenseExists(request.resource.data.expenseId)
          && request.resource.data.houseId == notifExpenseData(request.resource.data.expenseId).houseId
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.read == false
          && ("createdAt" in request.resource.data)
          && !("pushSentAt" in request.resource.data)
          && !("pushFailedAt" in request.resource.data)
          && !("pushMessageId" in request.resource.data)
          && !("pushErrorCode" in request.resource.data);
    }

    // Bill creation: the expense creator notifies an enrolled participant
    // of a still-pending bill. Document ID is exactly
    // `{expenseId}_{recipientUid}_bill_created`.
    function notifBillCreated(uid, nid, expenseId) {
      return request.resource.data.type == "expense_request"
          && nid == expenseId + "_" + uid + "_bill_created"
          && notifExpenseData(expenseId).createdBy == request.auth.uid
          && notifParticipantExists(expenseId, uid)
          && notifExpenseData(expenseId).status == "pending"
          && notifParticipantData(expenseId, uid).status == "pending"
          && request.resource.data.billAmount is number
          && request.resource.data.billAmount == notifExpenseData(expenseId).totalAmount;
    }

    // Payment submission: a paid participant notifies the expense creator.
    // Document ID is exactly
    // `{expenseId}_{senderUid}_payment_proof_submitted_{revision}`.
    function notifSubmitted(uid, nid, expenseId) {
      return request.resource.data.type == "payment_proof_submitted"
          && nid == expenseId + "_" + request.auth.uid + "_payment_proof_submitted_" + string(request.resource.data.paymentProofRevision)
          && notifExpenseData(expenseId).createdBy == uid
          && notifParticipantExists(expenseId, request.auth.uid)
          && notifParticipantData(expenseId, request.auth.uid).status == "paid"
          && request.resource.data.billAmount is number
          && request.resource.data.billAmount == notifParticipantData(expenseId, request.auth.uid).amountOwed
          && request.resource.data.paymentProofRevision is number
          && request.resource.data.paymentProofRevision == notifParticipantData(expenseId, request.auth.uid).paymentProofRevision;
    }

    // Owner approval: the creator notifies a confirmed (approved) participant.
    // Document ID is exactly
    // `{expenseId}_{recipientUid}_payment_proof_approved_{revision}`.
    function notifApproved(uid, nid, expenseId) {
      return request.resource.data.type == "payment_proof_approved"
          && nid == expenseId + "_" + uid + "_payment_proof_approved_" + string(request.resource.data.paymentProofRevision)
          && notifExpenseData(expenseId).createdBy == request.auth.uid
          && notifParticipantExists(expenseId, uid)
          && notifParticipantData(expenseId, uid).status == "confirmed"
          && notifParticipantData(expenseId, uid).paymentProofStatus == "approved"
          && request.resource.data.billAmount is number
          && request.resource.data.billAmount == notifParticipantData(expenseId, uid).amountOwed
          && request.resource.data.paymentProofRevision is number
          && request.resource.data.paymentProofRevision == notifParticipantData(expenseId, uid).paymentProofRevision;
    }

    // Owner rejection: the creator notifies a rejected participant.
    // Document ID is exactly
    // `{expenseId}_{recipientUid}_payment_proof_rejected_{revision}`.
    function notifRejected(uid, nid, expenseId) {
      return request.resource.data.type == "payment_proof_rejected"
          && nid == expenseId + "_" + uid + "_payment_proof_rejected_" + string(request.resource.data.paymentProofRevision)
          && notifExpenseData(expenseId).createdBy == request.auth.uid
          && notifParticipantExists(expenseId, uid)
          && notifParticipantData(expenseId, uid).status == "pending"
          && notifParticipantData(expenseId, uid).paymentProofStatus == "rejected"
          && request.resource.data.paymentProofRevision is number
          && request.resource.data.paymentProofRevision == notifParticipantData(expenseId, uid).paymentProofRevision;
    }

    // Batch payment confirmation: the creator notifies a confirmed participant.
    // Document ID is exactly `{expenseId}_{recipientUid}_payment_confirmed_batch`.
    function notifConfirmed(uid, nid, expenseId) {
      return request.resource.data.type == "payment_confirmed"
          && nid == expenseId + "_" + uid + "_payment_confirmed_batch"
          && notifExpenseData(expenseId).createdBy == request.auth.uid
          && notifParticipantExists(expenseId, uid)
          && notifParticipantData(expenseId, uid).status == "confirmed"
          && request.resource.data.billAmount is number
          && request.resource.data.billAmount == notifParticipantData(expenseId, uid).amountOwed;
    }

    // Bill settlement: the creator notifies a participant of a confirmed bill.
    // Document ID is exactly `{expenseId}_{recipientUid}_bill_settled` (single
    // approval flow) or `{expenseId}_{recipientUid}_bill_settled_batch`
    // (batch settlement flow): the only two producer shapes.
    function notifSettled(uid, nid, expenseId) {
      return request.resource.data.type == "bill_paid"
          && (
            nid == expenseId + "_" + uid + "_bill_settled" ||
            nid == expenseId + "_" + uid + "_bill_settled_batch"
          )
          && notifExpenseData(expenseId).createdBy == request.auth.uid
          && notifParticipantExists(expenseId, uid)
          && notifExpenseData(expenseId).status == "confirmed"
          && request.resource.data.billAmount is number
          && request.resource.data.billAmount == notifExpenseData(expenseId).totalAmount;
    }

    // Per-user in-app notifications collection.
    match /user_notifications/{uid}/notifications/{nid} {
      // Users may read their own notifications
      allow read: if isSelf(uid);

      // Client creation is limited to the legitimate producer envelope:
      // sender-bound, allowlisted type, real expense with matching house,
      // deterministic document ID, role-checked sender/recipient, and
      // financial values pinned to the authoritative expense/participant
      // documents. Everything else (server types, unknown types, forgeries)
      // is denied. Updates/deletes restricted to the notification owner,
      // so a sender cannot rewrite a delivered notification.
      allow create: if notifBaseValid(uid)
          && (
            notifBillCreated(uid, nid, request.resource.data.expenseId) ||
            notifSubmitted(uid, nid, request.resource.data.expenseId) ||
            notifApproved(uid, nid, request.resource.data.expenseId) ||
            notifRejected(uid, nid, request.resource.data.expenseId) ||
            notifConfirmed(uid, nid, request.resource.data.expenseId) ||
            notifSettled(uid, nid, request.resource.data.expenseId)
          );
      allow update, delete: if isSelf(uid);
    }

    match /house_user_meta/{metaId} {
      allow read: if signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.houseId is string
          && (isHouseMember(resource.data.houseId) || isHouseLeader(resource.data.houseId));

      allow create, update: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.houseId is string
          && (isHouseMember(request.resource.data.houseId) || isHouseLeader(request.resource.data.houseId));

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    function expenseExists(expenseId) {
      return exists(/databases/$(database)/documents/house_expenses/$(expenseId));
    }

    function expenseData(expenseId) {
      return get(/databases/$(database)/documents/house_expenses/$(expenseId)).data;
    }

    function expenseDataAfter(expenseId) {
      return getAfter(/databases/$(database)/documents/house_expenses/$(expenseId)).data;
    }

    function expenseHouseId(expenseId) {
      return expenseData(expenseId).houseId;
    }

    // Ordinary-member payment submission contract. Mirrors exactly the
    // ExpenseService.markAsPaid update payload (pending -> paid with the 9
    // submission keys). Anything outside that allowlist — amountOwed,
    // userId, confirmedAt, approval metadata — is denied even when the
    // resulting status is "paid". Absent-vs-null safe: legacy participant
    // documents may lack optional proof fields, and rejected documents
    // carry explicit nulls; both shapes must resubmit successfully.
    function memberPaidSubmission(expenseId, userId) {
      return signedIn()
          && expenseExists(expenseId)
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "paid"
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.amountOwed == resource.data.amountOwed
          && (
            (!("confirmedAt" in resource.data) && !("confirmedAt" in request.resource.data)) ||
            (("confirmedAt" in resource.data) && ("confirmedAt" in request.resource.data) &&
                request.resource.data.confirmedAt == resource.data.confirmedAt)
          )
          && request.resource.data.paymentProofStatus == "submitted"
          && request.resource.data.paymentProofReviewedAt == null
          && request.resource.data.paymentProofReviewReason == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ["status", "paidAt", "paymentProofStatus", "paymentProofRevision",
             "paymentProofNote", "paymentProofs", "paymentProofSubmittedAt",
             "paymentProofReviewedAt", "paymentProofReviewReason"]
          );
    }

    match /house_expenses/{expenseId} {
      allow read: if signedIn()
          && resource.data.houseId is string
          && (isHouseMember(resource.data.houseId) || isHouseLeader(resource.data.houseId));

      allow create: if signedIn()
          && request.resource.data.houseId is string
          && request.resource.data.title is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.totalAmount is number
          && request.resource.data.perPersonAmount is number
          && request.resource.data.status == "pending"
          && isHouseLeader(request.resource.data.houseId);

      allow update, delete: if signedIn()
          && expenseExists(expenseId)
          && isHouseLeader(expenseHouseId(expenseId));

      match /participants/{userId} {
        // Participant documents contain private financial data (amountOwed,
        // status, paidAt, confirmedAt, payment proof metadata). Only the house
        // leader may read all of them; a normal member may read only their own
        // participant document (document IDs are user IDs).
        allow read: if signedIn()
            && expenseExists(expenseId)
            && (isHouseLeader(expenseHouseId(expenseId)) || request.auth.uid == userId);

        allow create: if signedIn()
          && expenseDataAfter(expenseId).houseId is string
          && isHouseLeader(expenseDataAfter(expenseId).houseId)
          && request.resource.data.userId is string
          && request.resource.data.amountOwed is number
          && (request.resource.data.status == "pending" || request.resource.data.status == "confirmed")
          && request.resource.data.userId == userId;

        allow update: if signedIn()
            && expenseExists(expenseId)
            && (
              isHouseLeader(expenseHouseId(expenseId)) ||
              memberPaidSubmission(expenseId, userId)
            );

        allow delete: if signedIn() && expenseExists(expenseId) && isHouseLeader(expenseHouseId(expenseId));
      }
    }
  }
}
